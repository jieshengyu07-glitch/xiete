/* Campus Assistant visual tokens
 * brand #1677ff · canvas #f5f7fa · surface #ffffff
 * text #172033 / #596579 / #8a94a6
 * radius 14 / 20 / 24rpx · spacing 8 / 16 / 24 / 32rpx
 */
page {
  min-height: 100%;
  background: #f5f7fa;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

button { box-sizing: border-box; }
button::after { border: 0; }
button[disabled] { opacity: .52; }

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx;
  background: #f5f7fa;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 20rpx;
  background: #ffffff;
}

.card-title {
  margin-bottom: 20rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 650;
}

.row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #edf1f5; }
.row:last-child { border-bottom: 0; }
.label { flex-shrink: 0; color: #596579; font-size: 26rpx; }
.value { color: #27344a; font-size: 26rpx; font-weight: 600; text-align: right; word-break: break-all; }

.btn {
  display: block;
  width: 100%;
  min-height: 84rpx;
  margin: 24rpx 0 0;
  border-radius: 14rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 84rpx;
}
.btn:active { opacity: .86; }
.secondary { background: #edf5ff; color: #1677ff; }

.empty { padding: 36rpx 0; color: #8a94a6; font-size: 26rpx; text-align: center; }
.loading { padding: 64rpx 0; color: #8a94a6; font-size: 26rpx; text-align: center; }
.tips { margin-top: 12rpx; color: #6b7688; font-size: 24rpx; line-height: 1.65; }
