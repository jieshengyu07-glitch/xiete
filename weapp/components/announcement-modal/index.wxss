.announcement-mask { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 48rpx 36rpx; background: rgba(23, 32, 51, .48); }
.announcement-card { box-sizing: border-box; width: 100%; max-height: 88vh; overflow-y: auto; padding: 32rpx 28rpx 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 20rpx 60rpx rgba(23, 32, 51, .18); }
.announcement-title { color: #172033; font-size: 34rpx; font-weight: 700; line-height: 1.35; text-align: center; }
.announcement-content { margin-top: 14rpx; color: #596579; font-size: 25rpx; line-height: 1.65; text-align: center; }
.announcement-image { display: block; width: 100%; margin-top: 24rpx; border: 1rpx solid #e8edf4; border-radius: 16rpx; background: #f5f7fa; }
.announcement-tip { margin-top: 12rpx; color: #8a94a6; font-size: 22rpx; text-align: center; }
.announcement-actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.announcement-button { flex: 1; min-height: 76rpx; margin: 0; border-radius: 14rpx; font-size: 26rpx; font-weight: 650; line-height: 76rpx; }
.announcement-preview { background: #edf5ff; color: #1677ff; }
.announcement-close { background: #1677ff; color: #fff; }
