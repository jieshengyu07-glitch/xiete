<view class="container">
  <view class="status-card">
    <view class="status-label">校园账号</view>
    <view class="status-value status-{{statusTone}}">{{statusTitle}}</view>
    <view class="status-desc">{{statusDesc}}</view>
    <view wx:if="{{lastSyncText}}" class="status-meta">最近同步时间：{{lastSyncText}}</view>
    <view wx:if="{{syncMetaText}}" class="status-meta">{{syncMetaText}}</view>
  </view>

  <view wx:if="{{!hasBoundJwxt || status === 'RELOGIN_REQUIRED' || status === 'CAPTCHA_REQUIRED' || binding || showCaptcha}}" class="card bind-card">
    <view class="card-title">{{status === 'RELOGIN_REQUIRED' || status === 'CAPTCHA_REQUIRED' ? '重新验证校园账号' : '绑定校园账号'}}</view>
    <view class="hint">校园账号信息通过加密连接传输，仅用于登录学校教务系统并同步成绩和课表。密码由服务端加密保存，前端不会在本地保存密码。</view>
    <input class="input" placeholder="请输入学号" value="{{studentId}}" disabled="{{showCaptcha}}" bindinput="onStudentIdInput" />
    <input class="input" placeholder="请输入教务密码" password value="{{password}}" disabled="{{showCaptcha}}" bindinput="onPasswordInput" />
    <view wx:if="{{showCaptcha}}" class="captcha-panel">
      <view class="captcha-title">安全验证</view>
      <view class="captcha-desc">学校系统本次要求图片验证码，完成后即可继续使用。</view>
      <view wx:if="{{captchaLoading}}" class="captcha-placeholder">正在获取验证码...</view>
      <image wx:elif="{{captchaImage}}" class="captcha-image" src="{{captchaImage}}" mode="aspectFit" />
      <view wx:else class="captcha-placeholder">验证码加载失败，请点击刷新</view>
      <input class="input captcha-input" placeholder="请输入图片中的验证码" value="{{captchaValue}}" maxlength="8" bindinput="onCaptchaInput" />
      <view class="captcha-actions">
        <button class="captcha-btn" disabled="{{captchaLoading || captchaSubmitting}}" bindtap="refreshCaptcha">换一张</button>
        <button class="captcha-btn captcha-submit" loading="{{captchaSubmitting}}" disabled="{{captchaLoading || captchaSubmitting || !captchaImage}}" bindtap="submitCaptcha">完成验证</button>
      </view>
      <button class="captcha-cancel" disabled="{{captchaSubmitting}}" bindtap="cancelCaptchaByUser">取消</button>
    </view>
    <view class="privacy-consent">
      <checkbox-group bindchange="onPrivacyChange">
        <label class="privacy-label"><checkbox value="accepted" checked="{{privacyAccepted}}" color="#1677ff" />我已阅读并同意</label>
      </checkbox-group>
      <text class="privacy-link" bindtap="openPrivacy">《用户隐私保护指引（用户协议和隐私政策）》</text>
    </view>
    <view wx:if="{{!privacyAccepted}}" class="hint">请先阅读并同意用户协议和隐私政策</view>
    <button wx:if="{{!showCaptcha}}" class="bind-btn" loading="{{binding}}" disabled="{{binding || !privacyAccepted}}" bindtap="bindAccount">{{status === 'RELOGIN_REQUIRED' ? '重新验证校园账号' : '绑定校园账号'}}</button>
    <view wx:if="{{showRebindActions}}" class="action-row">
      <button class="light-btn" bindtap="retryLater">稍后再试</button>
    </view>
  </view>

  <view wx:if="{{hasBoundJwxt && status !== 'RELOGIN_REQUIRED' && status !== 'CAPTCHA_REQUIRED'}}" class="card bound-card">
    <view class="card-title">校园账号已绑定</view>
    <view wx:if="{{maskedStudentId}}" class="hint">学号：{{maskedStudentId}}</view>
    <view class="hint">系统会自动同步课表和成绩，无需重复登录。若更换教务密码，可先解除绑定后重新绑定。</view>
    <view wx:if="{{bindingSuccess}}" class="success-actions">
      <button class="bind-btn" bindtap="viewGrades">查看我的成绩</button>
      <button class="light-btn" bindtap="viewTodayTimetable">查看今日课表</button>
    </view>
    <button class="light-btn" bindtap="refreshStatus">验证账号状态</button>
    <button class="unbind-btn" loading="{{unbinding}}" disabled="{{unbinding}}" bindtap="unbindAccount">解除绑定</button>
  </view>

  <view wx:if="{{hasBoundJwxt && (status === 'RELOGIN_REQUIRED' || status === 'CAPTCHA_REQUIRED')}}" class="card bound-card">
    <view class="card-title">账号验证</view>
    <view class="hint">历史课表和成绩不会被删除。完成验证后即可继续同步。</view>
    <button class="unbind-btn" loading="{{unbinding}}" disabled="{{unbinding}}" bindtap="unbindAccount">解除绑定</button>
  </view>

</view>
