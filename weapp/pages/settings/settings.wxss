.status-card { margin-bottom: 20rpx; padding: 30rpx 28rpx; border: 1rpx solid #e8edf4; border-radius: 20rpx; background: #fff; }
.status-label { color: #8a94a6; font-size: 23rpx; }
.status-value { margin-top: 8rpx; color: #27344a; font-size: 36rpx; font-weight: 700; line-height: 1.25; }
.status-ok { color: #1677ff; }
.status-warn { color: #9a5b09; }
.status-err { color: #c9362b; }
.status-muted { color: #27344a; }
.status-desc { margin-top: 10rpx; color: #596579; font-size: 24rpx; line-height: 1.55; }
.status-meta { margin-top: 10rpx; color: #8a94a6; font-size: 22rpx; }
.bind-card, .bound-card { padding-bottom: 26rpx; }
.hint { margin-bottom: 20rpx; color: #596579; font-size: 24rpx; line-height: 1.65; }
.input { box-sizing: border-box; width: 100%; min-height: 84rpx; margin-bottom: 16rpx; padding: 0 22rpx; border: 1rpx solid #d9e0ea; border-radius: 14rpx; background: #fafbfd; color: #27344a; font-size: 27rpx; }
.input:focus { border-color: #7db2fa; background: #fff; }
.bind-btn { min-height: 84rpx; margin-top: 8rpx; border-radius: 14rpx; background: #1677ff; color: #fff; font-size: 27rpx; font-weight: 650; line-height: 84rpx; }
.privacy-consent { display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx; margin: 4rpx 0 18rpx; color: #596579; font-size: 23rpx; }
.privacy-label { display: flex; align-items: center; }
.privacy-label checkbox { transform: scale(.8); }
.privacy-link { color: #1677ff; font-weight: 600; }
.action-row { margin-top: 16rpx; }
.light-btn { min-height: 76rpx; margin: 10rpx 0 0; border-radius: 14rpx; background: #edf5ff; color: #1677ff; font-size: 25rpx; font-weight: 600; line-height: 76rpx; }
.captcha-panel { margin-bottom: 18rpx; padding: 20rpx; border: 1rpx solid #e1e8f1; border-radius: 16rpx; background: #f7f9fc; }
.captcha-title { color: #27344a; font-size: 26rpx; font-weight: 650; }
.captcha-desc { margin: 8rpx 0 16rpx; color: #596579; font-size: 23rpx; line-height: 1.6; }
.captcha-image { width: 260rpx; height: 92rpx; margin-bottom: 16rpx; border: 1rpx solid #e8edf4; border-radius: 10rpx; background: #fff; }
.captcha-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 92rpx; margin-bottom: 16rpx; border-radius: 10rpx; background: #fff; color: #8a94a6; font-size: 23rpx; }
.captcha-input { background: #fff; }
.captcha-actions { display: flex; gap: 14rpx; }
.captcha-btn { flex: 1; min-height: 72rpx; margin: 0; border-radius: 14rpx; background: #edf5ff; color: #1677ff; font-size: 25rpx; line-height: 72rpx; }
.captcha-submit { background: #1677ff; color: #fff; }
.captcha-cancel { min-height: 64rpx; margin: 10rpx 0 0; background: transparent; color: #596579; font-size: 23rpx; line-height: 64rpx; }
.unbind-btn { min-height: 76rpx; margin-top: 18rpx; border: 1rpx solid #f0c9c6; border-radius: 14rpx; background: #fff; color: #c9362b; font-size: 25rpx; line-height: 76rpx; }
