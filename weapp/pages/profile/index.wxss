.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #f5f7fa;
}

.wechat-summary {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 8rpx 4rpx 20rpx;
  border-bottom: 1rpx solid #e1e7ef;
}

.avatar-img {
  display: block;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #edf5ff;
}

.wechat-copy { flex: 1; min-width: 0; }
.summary-label { color: #596579; font-size: 23rpx; }
.summary-value { margin-top: 4rpx; color: #172033; font-size: 29rpx; font-weight: 650; }

.campus-card,
.privacy-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 20rpx;
  background: #ffffff;
}

.section-title { margin-bottom: 16rpx; color: #172033; font-size: 28rpx; font-weight: 650; }
.campus-status { display: inline-flex; padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 23rpx; font-weight: 600; }
.campus-description { margin-top: 14rpx; color: #596579; font-size: 24rpx; line-height: 1.55; }
.ok { background: #edf8f1; color: #16794a; }
.warn { background: #fff6e6; color: #9a5b09; }
.muted { background: #f0f2f5; color: #596579; }
.err { background: #fff1f0; color: #c9362b; }

.campus-action {
  width: 100%;
  min-height: 82rpx;
  margin: 24rpx 0 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 82rpx;
}

.primary { background: #1677ff; color: #ffffff; }
.secondary-action { background: #edf5ff; color: #1677ff; }

.data-section { margin-bottom: 20rpx; }
.data-section > .section-title { margin-left: 4rpx; }
.data-grid { display: flex; gap: 16rpx; }
.data-item { flex: 1; min-width: 0; padding: 22rpx; border: 1rpx solid #e8edf4; border-radius: 16rpx; background: #ffffff; }
.data-label { color: #596579; font-size: 23rpx; }
.data-value { margin-top: 10rpx; color: #27344a; font-size: 24rpx; font-weight: 600; line-height: 1.45; word-break: break-all; }
.muted-text { color: #7a8596; font-weight: 400; }

.privacy-action {
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  border-bottom: 1rpx solid #edf1f5;
  background: transparent;
  color: #27344a;
  font-size: 25rpx;
  line-height: 76rpx;
  text-align: left;
}

.privacy-action.danger {
  margin-top: 22rpx;
  border: 1rpx solid #f0c9c6;
  border-radius: 14rpx;
  background: #ffffff;
  color: #c9362b;
  text-align: center;
}

.disclaimer { padding: 8rpx 20rpx 24rpx; color: #6f7a8b; font-size: 22rpx; line-height: 1.5; text-align: center; }
