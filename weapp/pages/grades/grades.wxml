<view class="container grades-page">
  <view wx:if="{{isInitialLoading && grades.length===0}}" class="card"><view class="loading">加载中...</view></view>

  <view wx:elif="{{authRequired}}" class="card auth-card">
    <view class="auth-title">登录后查看成绩</view>
    <view class="auth-desc">先完成微信登录，再验证校园账号，即可同步成绩。</view>
    <button class="auth-button" bindtap="goLogin">前往登录</button>
  </view>

  <block wx:else>
    <view wx:if="{{accountState==='UNBOUND'}}" class="onboarding-card">
      <view class="onboarding-title">绑定校园账号后即可查询成绩</view>
      <view class="onboarding-description">绑定后可以查看各学期课程成绩，同步后的历史成绩仍会保留。</view>
      <button class="btn onboarding-action" bindtap="manageCampusAccount">绑定校园账号</button>
    </view>

    <block wx:else>
      <view wx:if="{{groupedGrades.length}}" class="term-toolbar">
        <picker class="term-picker" mode="selector" range="{{termLabels}}" value="{{activeTermIndex}}" bindchange="selectTerm">
          <view class="selector-label">当前学期</view>
          <view class="selector-value">
            <view class="selector-copy">
              <text>{{currentGroup.termName}}</text>
              <text class="selector-count">{{currentGrades.length}} 门课程<text wx:if="{{lastSuccessAtText}}"> · {{lastSuccessAtText}}</text></text>
            </view>
            <text class="selector-arrow">⌄</text>
          </view>
        </picker>
        <button class="refresh-btn" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="refreshGrades">{{refreshButtonText}}</button>
      </view>

      <view wx:if="{{accountNotice}}" class="account-notice">
        <text>{{accountNotice}}</text>
        <text wx:if="{{accountActionText}}" class="notice-action" bindtap="manageCampusAccount">{{accountActionText}}</text>
      </view>
      <view wx:if="{{syncing}}" class="notice-card">
        <view>{{notice || "正在更新成绩"}}</view>
        <view wx:if="{{syncing && refreshStage}}" class="notice-stage">{{refreshStage}}</view>
      </view>
      <view wx:elif="{{notice}}" class="notice-card">{{notice}}</view>
      <view wx:if="{{refreshError}}" class="notice-card error-notice">{{refreshError}}</view>

      <block wx:if="{{!syncing && grades.length===0}}">
        <view wx:if="{{emptyState==='NO_DATA'}}" class="card empty-card">
          <view class="empty-title">还没有同步到成绩</view>
          <view class="tips">完成同步后，各学期成绩会显示在这里。</view>
          <button class="btn" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="refreshGrades">同步成绩</button>
        </view>
      </block>

      <view wx:elif="{{emptyState==='EMPTY_TERM'}}" class="card empty-card compact-empty">
        <view class="empty-title">本学期暂无成绩</view>
        <view class="tips">可以切换到其他学期查看历史成绩。</view>
      </view>

      <block wx:if="{{grades.length>0}}">
        <block wx:if="{{emptyState==='HAS_DATA' && currentGroup}}">
          <view class="grade-list">
            <view wx:for="{{currentGrades}}" wx:for-item="grade" wx:key="id" class="grade-card">
              <view class="course-name">{{grade.courseName}}</view>
              <view class="grade-info">
                <view class="score-block">
                  <text class="info-label">成绩</text>
                  <text class="score">{{grade.score}}</text>
                </view>
                <view wx:if="{{grade.raw.credit || grade.raw.xf || grade.raw.XF}}" class="info-item">
                  <text class="info-label">学分</text>
                  <text class="info-value">{{grade.raw.credit || grade.raw.xf || grade.raw.XF}}</text>
                </view>
                <view wx:if="{{grade.raw.courseType || grade.raw.kcxz || grade.raw.KCXZ}}" class="info-item">
                  <text class="info-label">类型</text>
                  <text class="info-value">{{grade.raw.courseType || grade.raw.kcxz || grade.raw.KCXZ}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>
    </block>
  </block>
</view>
