.grades-page {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.auth-card {
  margin-top: 72rpx;
  padding: 56rpx 36rpx 40rpx;
  text-align: center;
}

.auth-title {
  color: #152338;
  font-size: 34rpx;
  font-weight: 850;
}

.auth-desc {
  margin: 18rpx auto 32rpx;
  color: #77849a;
  font-size: 25rpx;
  line-height: 1.65;
}

.auth-button {
  height: 84rpx;
  margin: 0;
  border-radius: 18rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
}

.onboarding-card {
  margin-top: 18rpx;
  padding: 56rpx 36rpx 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(38, 84, 153, 0.08);
  text-align: center;
}

.onboarding-title {
  color: #152338;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.45;
}

.onboarding-description {
  margin: 18rpx auto 0;
  color: #77849a;
  font-size: 25rpx;
  line-height: 1.65;
}

.onboarding-action {
  margin-top: 30rpx;
}

.term-toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(38, 84, 153, 0.07);
}

.term-picker {
  display: block;
  flex: 1;
  min-width: 0;
}

.term-tabs {
  width: 100%;
  margin: 0 -2rpx 24rpx;
  white-space: nowrap;
}

.term-tabs-track {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 2rpx 8rpx;
}

.term-tab {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  padding: 0 30rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 36rpx;
  background: #ffffff;
  color: #526079;
  font-size: 25rpx;
  line-height: 72rpx;
  white-space: nowrap;
}

.term-tab-active {
  border-color: #1677ff;
  background: #1677ff;
  color: #ffffff;
  font-weight: 700;
}

.term-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 4rpx 18rpx;
}

.term-heading-title {
  color: #152338;
  font-size: 30rpx;
  font-weight: 800;
}

.term-heading-count {
  color: #8a94a6;
  font-size: 23rpx;
}

.refresh-btn {
  flex-shrink: 0;
  width: 172rpx;
  height: 72rpx;
  margin: 0;
  border-radius: 16rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 72rpx;
}

.notice-card,
.account-notice {
  margin-bottom: 18rpx;
  padding: 17rpx 22rpx;
  border: 1rpx solid #cfe2ff;
  border-radius: 16rpx;
  background: #f0f6ff;
  color: #2f5f9f;
  font-size: 24rpx;
  line-height: 1.5;
}

.account-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.account-notice text:first-child {
  flex: 1;
}

.notice-action {
  flex-shrink: 0;
  color: #1677ff;
  font-weight: 700;
}

.notice-stage {
  margin-top: 6rpx;
  color: #60789b;
  font-size: 23rpx;
}

.error-notice {
  border-color: #f2d3d3;
  background: #fff7f7;
  color: #a24747;
}

.selector-label {
  margin-bottom: 10rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.selector-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #152338;
  font-size: 28rpx;
  font-weight: 750;
}

.selector-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.selector-copy text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-count {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
  font-weight: 400;
}

.selector-arrow {
  display: none;
}

.empty-title {
  color: #152338;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.compact-empty {
  padding-top: 36rpx;
  padding-bottom: 36rpx;
  text-align: center;
}

.grade-list {
  display: block;
}

.grade-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(38, 84, 153, 0.08);
}

.course-name {
  display: -webkit-box;
  margin-bottom: 22rpx;
  overflow: hidden;
  color: #152338;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.45;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.grade-info {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
}

.score-block,
.info-item {
  flex: 1;
  min-width: 0;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f9ff;
}

.score-block {
  flex: 1.1;
  background: #eef6ff;
}

.info-label {
  display: block;
  margin-bottom: 8rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.score {
  display: block;
  min-width: 96rpx;
  max-width: 180rpx;
  overflow: hidden;
  color: #1677ff;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-value {
  display: block;
  overflow: hidden;
  color: #25324a;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}
