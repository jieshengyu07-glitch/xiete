.landing-page { min-height: 100vh; box-sizing: border-box; padding: 48rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); background: #f5f7fa; }
.brand-card { padding: 36rpx 8rpx 30rpx; color: #172033; }
.brand-name { font-size: 44rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-desc { margin-top: 10rpx; color: #596579; font-size: 26rpx; line-height: 1.55; }
.scope-card { padding: 30rpx 28rpx; border: 1rpx solid #e8edf4; border-radius: 20rpx; background: #fff; }
.scope-title { color: #172033; font-size: 30rpx; font-weight: 650; }
.scope-highlight { margin-top: 18rpx; padding: 18rpx 20rpx; border-left: 5rpx solid #1677ff; border-radius: 0 12rpx 12rpx 0; background: #f3f8ff; color: #245890; font-size: 25rpx; font-weight: 600; line-height: 1.6; }
.scope-item { display: flex; gap: 18rpx; margin-top: 26rpx; }
.scope-index { flex-shrink: 0; width: 40rpx; height: 40rpx; border-radius: 50%; background: #edf5ff; color: #1677ff; font-size: 22rpx; font-weight: 650; line-height: 40rpx; text-align: center; }
.scope-content { flex: 1; min-width: 0; }
.scope-label { color: #27344a; font-size: 26rpx; font-weight: 650; }
.scope-text { margin-top: 6rpx; color: #596579; font-size: 24rpx; line-height: 1.65; }
.unofficial-note { margin: 20rpx 8rpx; color: #8a94a6; font-size: 22rpx; line-height: 1.5; text-align: center; }
.continue-btn { min-height: 84rpx; margin: 0; border-radius: 14rpx; background: #1677ff; color: #fff; font-size: 28rpx; font-weight: 650; line-height: 84rpx; }
.privacy-link { padding: 24rpx 0 8rpx; color: #1677ff; font-size: 24rpx; font-weight: 600; text-align: center; }
