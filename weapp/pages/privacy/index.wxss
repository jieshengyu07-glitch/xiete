.privacy-page { min-height: 100vh; box-sizing: border-box; padding: 36rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); background: #fff; }
.privacy-card { max-width: 700rpx; margin: 0 auto; }
.title { color: #172033; font-size: 38rpx; font-weight: 700; }
.updated { margin: 10rpx 0 32rpx; color: #8a94a6; font-size: 22rpx; }
.section-title { margin: 32rpx 0 10rpx; padding-top: 28rpx; border-top: 1rpx solid #edf1f5; color: #27344a; font-size: 28rpx; font-weight: 650; }
.text { color: #596579; font-size: 25rpx; line-height: 1.8; }
.official-btn, .withdraw-btn { min-height: 82rpx; margin-top: 32rpx; border-radius: 14rpx; font-size: 26rpx; line-height: 82rpx; }
.official-btn { background: #1677ff; color: #fff; }
.withdraw-btn { border: 1rpx solid #f0c9c6; background: #fff; color: #c9362b; }
