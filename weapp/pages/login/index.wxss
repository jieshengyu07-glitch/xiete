.login-page { min-height: 100vh; box-sizing: border-box; padding: 40rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); background: #f5f7fa; }
.login-card { max-width: 680rpx; margin: 28rpx auto 0; padding: 40rpx 32rpx; border: 1rpx solid #e8edf4; border-radius: 24rpx; background: #fff; }
.login-eyebrow { color: #1677ff; font-size: 24rpx; font-weight: 650; letter-spacing: 2rpx; }
.login-title { margin-top: 12rpx; color: #172033; font-size: 40rpx; font-weight: 700; }
.login-desc { margin-top: 14rpx; color: #596579; font-size: 25rpx; line-height: 1.65; }
.login-scope { margin-top: 28rpx; padding: 22rpx 0; border-top: 1rpx solid #edf1f5; border-bottom: 1rpx solid #edf1f5; }
.login-scope-title { color: #27344a; font-size: 26rpx; font-weight: 650; }
.login-scope-text { margin-top: 10rpx; color: #6b7688; font-size: 23rpx; line-height: 1.6; }
.primary-btn { min-height: 84rpx; margin-top: 30rpx; border-radius: 14rpx; background: #1677ff; color: #fff; font-size: 28rpx; font-weight: 650; line-height: 84rpx; }
.privacy-consent { display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx; margin-top: 26rpx; color: #596579; font-size: 23rpx; }
.privacy-label { display: flex; align-items: center; }
.privacy-label checkbox { transform: scale(.8); }
.privacy-link { color: #1677ff; font-weight: 600; }
.error-text { margin-top: 16rpx; color: #c9362b; font-size: 23rpx; line-height: 1.5; }
.secondary-note { margin-top: 24rpx; color: #8a94a6; font-size: 22rpx; line-height: 1.6; }
